#!/usr/bin/env bash
set -Eeuo pipefail
core="${KENOFORGE_ROOT:-$HOME/.kenoforge/System/Core}"
command -v python3 >/dev/null 2>&1 || {
    printf '%s\n' 'KenoForge Monitor requires Python 3.10+ (Arch package: python).' >&2
    exit 1
}
[[ -r "$core/tools/live-monitor.py" ]] || {
    printf '%s\n' 'KenoForge Monitor was not found. Reinstall the current KenoForge package.' >&2
    exit 1
}
exec python3 -B "$core/tools/live-monitor.py" "$@"
